# Copy this file to .env in the same folder and adjust values for your environment.

# App
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elite_sacco
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=elite_sacco
PGSSLMODE=disable

# Optional PG pool tuning
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# CORS / security
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Password hashing
BCRYPT_ROUNDS=12

# Uploads
UPLOAD_DIR=./uploads

# Optional: app-level settings if you expose them elsewhere
APP_NAME=Elite SACCO Mbarara
COMPANY_NAME=Elite SACCO Mbarara
CURRENCY=UGX
DEFAULT_TIMEZONE=Africa/Kampala
