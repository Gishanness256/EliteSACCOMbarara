# ============================================================================
# ELITE SACCO MBARARA — ENVIRONMENT TEMPLATE
# File: .env.example
# Developed by Gisha-Tech Innovations
# ============================================================================
# This is a TEMPLATE. Copy it to `.env` and replace every placeholder value
# with a real secret before running the application:
#
#     cp .env.example .env
#     # then edit .env and fill in the real values
#
# !! SECURITY !!
# `.env` contains real secrets — NEVER commit it to version control.
# `.gitignore` already excludes it. Only `.env.example` (this file) is
# committed, and it contains PLACEHOLDERS ONLY.
#
# To generate strong random secrets on Linux/macOS:
#     openssl rand -base64 48      # 48-byte secret, base64-encoded
#     openssl rand -hex 32         # 32-byte secret, hex-encoded
#
# Or with Node.js:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ============================================================================


# ----------------------------------------------------------------------------
# 1. APPLICATION RUNTIME
# ----------------------------------------------------------------------------
NODE_ENV=development                  # development | staging | production
PORT=3000                             # HTTP port the app listens on
APP_URL=http://localhost:3000         # Public base URL (used for email links, CORS, etc.)
APP_NAME=Elite SACCO Mbarara          # Display name (also stored in settings.institution_name)
APP_TIMEZONE=Africa/Kampala           # Default timezone for date operations


# ----------------------------------------------------------------------------
# 2. DATABASE — primary connection (ORM-friendly URL form)
# ----------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Replace USER, PASSWORD, HOST and PORT with your real values.
# The database name `elite_sacco` matches schema.sql / seed.sql / policies.sql.
#
# In production, also set DB_SSL=true so the connection to MySQL uses TLS.
DATABASE_URL=mysql://sacco_app:CHANGE_ME_strong_db_password@localhost:3306/elite_sacco


# ----------------------------------------------------------------------------
# 2b. DATABASE — split form (for drivers / scripts that don't take a URL)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elite_sacco
DB_USER=sacco_app
DB_PASSWORD=CHANGE_ME_strong_db_password


# ----------------------------------------------------------------------------
# 3. DATABASE — connection pool tuning
# ----------------------------------------------------------------------------
DB_POOL_MIN=2                         # Minimum connections held in the pool
DB_POOL_MAX=10                        # Maximum concurrent connections
DB_POOL_IDLE_TIMEOUT_MS=30000          # Close idle connections after 30s
DB_POOL_ACQUIRE_TIMEOUT_MS=10000      # Wait up to 10s when the pool is exhausted


# ----------------------------------------------------------------------------
# 4. DATABASE — security flags (Row-Level Security integration)
# ----------------------------------------------------------------------------
DB_SSL=false                          # Set true in production to enforce TLS to MySQL
DB_SSL_REJECT_UNAUTHORIZED=true       # Reject self-signed certificates when DB_SSL=true
RLS_ENABLED=true                      # Call set_app_context(<user_id>) on every request when true
RLS_CLEAR_ON_RELEASE=true             # Call clear_app_context() before returning the connection


# ----------------------------------------------------------------------------
# 5. AUTHENTICATION & SESSIONS
# ----------------------------------------------------------------------------
# Used to sign session cookies. MUST be a long, random string (>= 64 chars).
# Generate with:  openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_to_a_64_char_random_string

# Session cookie settings
SESSION_COOKIE_NAME=elite_sacco_sid
SESSION_COOKIE_MAX_AGE_HOURS=12       # How long a login stays valid
SESSION_COOKIE_SECURE=false           # Set true in production (requires HTTPS)
SESSION_COOKIE_SAMESITE=lax           # none | lax | strict
SESSION_COOKIE_HTTPONLY=true          # Always true — prevents JS access to the cookie

# JWT settings (use only if you issue API tokens in addition to cookies)
JWT_SECRET=CHANGE_ME_another_64_char_random_string
JWT_EXPIRES_IN=12h


# ----------------------------------------------------------------------------
# 6. PASSWORD POLICY
# ----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=6                 # Mirrors settings.default_password_length
PASSWORD_BCRYPT_ROUNDS=12             # Cost factor for password hashing (10-12 typical)
PASSWORD_RESET_EXPIRY_HOURS=2         # How long a password-reset token stays valid


# ----------------------------------------------------------------------------
# 7. INITIAL ADMIN BOOTSTRAP
# ----------------------------------------------------------------------------
# Used only once, on first run, to seed the admin account whose placeholder
# row is in seed.sql. After bootstrap, the admin MUST change this password
# on first login (must_change_pw = 1).
BOOTSTRAP_ADMIN_EMAIL=admin@elitesacco.co.ug
BOOTSTRAP_ADMIN_TEMP_PASSWORD=CHANGE_ME_temporary_admin_password
BOOTSTRAP_ADMIN_INITIALS=SA


# ----------------------------------------------------------------------------
# 8. FILE UPLOADS — member passport photos, deposit slips, etc.
# ----------------------------------------------------------------------------
UPLOAD_DIR=./uploads                  # Local directory for uploaded files (dev)
UPLOAD_MAX_SIZE_MB=5                  # Maximum upload size
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# For production, switch to S3-compatible object storage (leave blank for local):
S3_ENDPOINT=                          # e.g. https://s3.amazonaws.com
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ----------------------------------------------------------------------------
# 9. EMAIL — SMTP for password-reset and notification emails
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false                     # true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Elite SACCO Mbarara
SMTP_FROM_ADDRESS=no-reply@elitesacco.co.ug


# ----------------------------------------------------------------------------
# 10. CORS — allowed origins for the API
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# In production, set to your real domain(s):
# CORS_ORIGINS=https://elitesacco.co.ug,https://admin.elitesacco.co.ug


# ----------------------------------------------------------------------------
# 11. RATE LIMITING — protect login and write endpoints
# ----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5         # Max login attempts per IP per minute
RATE_LIMIT_WRITE_PER_MINUTE=60        # Max write operations per session per minute
RATE_LIMIT_READ_PER_MINUTE=120        # Max read operations per session per minute


# ----------------------------------------------------------------------------
# 12. LOGGING & MONITORING
# ----------------------------------------------------------------------------
LOG_LEVEL=info                        # error | warn | info | debug
LOG_FORMAT=text                       # text (dev) | json (production)
SENTRY_DSN=                           # Leave blank to disable Sentry error reporting


# ----------------------------------------------------------------------------
# 13. REGULATORY DEFAULTS (app-side fallbacks; also seeded in settings table)
# ----------------------------------------------------------------------------
REGULATOR_NAME=Uganda Microfinance Regulatory Authority (UMRA)
REGULATOR_LICENCE_NUMBER=             # Fill in the SACCO's real UMRA licence number
AUDIT_LOG_RETENTION=5000              # Max audit-log entries before FIFO purge


# ----------------------------------------------------------------------------
# 14. SECURITY TOKENS
# ----------------------------------------------------------------------------
# Used to sign password-reset and email-verification tokens.
# Generate with:  openssl rand -hex 32
TOKEN_SECRET=CHANGE_ME_64_char_hex_secret_for_tokens

# Set to true in production to require HTTPS and set Secure cookies
ENFORCE_SSL=false


# ============================================================================
# END OF TEMPLATE — copy to .env and replace every CHANGE_ME_* placeholder.
# ============================================================================
