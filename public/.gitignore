# ============================================================================
# ELITE SACCO MBARARA — GIT IGNORE
# File: .gitignore
# ============================================================================
# CRITICAL: never commit `.env` (contains real secrets).
# Only `.env.example` (template with placeholders) is committed.
# ============================================================================

# ---- Environment files (REAL secrets — never commit) ----
.env
.env.local
.env.*.local
.env.production
.env.staging

# Keep the template committed (placeholders only — safe to share)
!.env.example

# ---- Application secrets / keys ----
*.pem
*.key
secrets/
private/

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# ---- Build artifacts ----
dist/
build/
.next/
out/
.cache/
*.tsbuildinfo

# ---- Logs ----
logs/
*.log
*.pid
*.seed
*.pid.lock

# ---- Coverage / test artifacts ----
coverage/
.nyc_output/
*.lcov

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Local uploads (dev only) ----
uploads/

# ---- Database dumps / backups ----
*.sql.bak
*.sql.gz
backups/
data/
