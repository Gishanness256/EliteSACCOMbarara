# Copy this file to .env and change values for your environment.

# App metadata
NODE_ENV=development
APP_NAME=Elite SACCO Mbarara
APP_URL=http://localhost:8080
BASE_URL=http://localhost:8080

# API configuration
API_BASE_URL=http://localhost:4000/api
API_URL=http://localhost:4000/api
AUTH_TOKEN_KEY=esacco_token

# Optional frontend behavior flags
ENABLE_PWA=true
DEFAULT_TIMEZONE=Africa/Kampala
CURRENCY=UGX

# If you use a separate public/admin domain later
PUBLIC_SITE_URL=http://localhost:8080
