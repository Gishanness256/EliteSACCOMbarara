{
  "name": "elite-sacco-mbarara",
  "version": "1.0.0",
  "description": "Elite SACCO Mbarara - standalone all-in-one PWA with built-in SQLite storage server",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backup": "node -e \"require('fs').copyFileSync(process.env.DB_PATH||'app.db','app-backup-'+new Date().toISOString().slice(0,10)+'.db');console.log('backup written')\""
  },
  "engines": { "node": ">=22.13.0" },
  "dependencies": {}
}
