{
  "name": "elite-sacco-mbarara",
  "version": "1.0.0",
  "private": true,
  "description": "Elite SACCO Mbarara — savings & credit cooperative management web app providing member registration, savings & loans tracking, portfolio-at-risk (PAR) analysis, member statement generation, loan servicing, financial reporting, KYC verification workflows, and a tamper-evident audit trail for governance and compliance.",
  "keywords": [
    "sacco",
    "microfinance",
    "mbarara",
    "uganda",
    "loans",
    "savings",
    "credit-cooperative",
    "financial-services",
    "elite-sacco",
    "umra",
    "par",
    "portfolio-at-risk"
  ],
  "homepage": "./",
  "license": "UNLICENSED",
  "author": "Gisha-Tech Innovations <info@gisha-tech.com>",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "scripts": {
  "start": "node src/server.js",
  "dev": "nodemon --watch src --watch migrations src/server.js",
  "lint": "eslint src/ migrations/ scripts/ --ext .js,.mjs",
  "lint:fix": "eslint src/ migrations/ scripts/ --ext .js,.mjs --fix",
  "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"migrations/**/*.js\"",
  "test": "jest --runInBand --forceExit --detectOpenHandles",
  "test:watch": "jest --watch --runInBand",
  "test:coverage": "jest --coverage --runInBand --forceExit --detectOpenHandles",
  "test:e2e": "jest --config jest.e2e.config.js --runInBand --forceExit"
}
  },
  "dependencies": {
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.2",
    "pdfjs-dist": "3.11.174",
    "xlsx": "0.18.5"
  }
}
